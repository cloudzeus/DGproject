# ==============================================================================
# A-SISYPHUS - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your values
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/a_sisyphus"

# ──────────────────────────────────────────────────────────────────────────
# Authentication & Authorization
# ──────────────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_REDIRECT_PROXY_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ──────────────────────────────────────────────────────────────────────────
# Per-project Secrets Vault
# ──────────────────────────────────────────────────────────────────────────
# Generate both secrets independently: openssl rand -base64 32
# VAULT_ENCRYPTION_KEY must decode to exactly 32 bytes (AES-256-GCM).
# Back it up securely outside the database; losing it makes stored values unreadable.
VAULT_ENCRYPTION_KEY="your-base64-encoded-32-byte-key"
VAULT_ENCRYPTION_KEY_VERSION="v1"
VAULT_OTP_SECRET="your-independent-otp-hmac-secret-at-least-32-bytes"

# ──────────────────────────────────────────────────────────────────────────
# Microsoft 365 Integration (MANDATORY)
# ──────────────────────────────────────────────────────────────────────────
TENANT_ID="your-tenant-id"
APPLICATION_ID="your-application-id"
OBJECT_ID="your-object-id"
CLIENT_SECRET_VALUE="your-client-secret"
CLIENT_SECRET_ID="your-secret-id"
# Optional comma-separated allowlist for Microsoft login and Directory imports.
# Leave empty to include every verified domain in the same tenant.
MICROSOFT_TENANT_DOMAINS="dgsmart.gr,dgsoft.gr"

# ──────────────────────────────────────────────────────────────────────────
# Mailgun Email Service
# ──────────────────────────────────────────────────────────────────────────
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="your-domain.com"
MAILGUN_ENDPOINT="https://api.eu.mailgun.net"
MAILGUN_FROM_EMAIL="pms@dgsmart.gr"
MAILGUN_FROM_NAME="DGSMART PROJECTS"

# ──────────────────────────────────────────────────────────────────────────
# BunnyCDN Storage & CDN
# ──────────────────────────────────────────────────────────────────────────
BUNNY_ACCESS_KEY="your-bunny-access-key"
BUNNY_CDN_HOSTNAME="your-domain.b-cdn.net"
BUNNY_STORAGE_ZONE="your-storage-zone"
BUNNY_STORAGE_API_HOST="storage.bunnycdn.com"

# ──────────────────────────────────────────────────────────────────────────
# Mailbox Configuration (Optional)
# ──────────────────────────────────────────────────────────────────────────
# delegated (default): send from each user's connected Microsoft mailbox.
# application: send from SHARED_MAILBOX_ADDRESS with client credentials.
# Application mode requires Microsoft Graph Application Mail.Send + admin consent.
MICROSOFT_MAIL_SEND_MODE="delegated"
SHARED_MAILBOX_ADDRESS="shared@yourdomain.com"
# Separate project-mail reading mode; it does not change the sending mailbox.
# Application read mode requires Microsoft Graph Application Mail.Read + admin consent.
MICROSOFT_MAIL_READ_MODE="delegated"
MICROSOFT_PROJECT_MAILBOX_ADDRESS="pms@dgsmart.gr"
JOBS_MAILBOX_ADDRESS="jobs@yourdomain.com"
CAREERS_MAILBOX_ADDRESS="careers@yourdomain.com"
TEAMS_BOOKING_EMAILS="booking@yourdomain.com"

# ──────────────────────────────────────────────────────────────────────────
# Site Configuration
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"
NEXT_PUBLIC_SUPPORTED_LANGUAGES="en,es,fr,de,pt,ja,zh"

# ──────────────────────────────────────────────────────────────────────────
# AI/LLM Services (Optional)
# ──────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_API_URL="https://api.deepseek.com/v1/chat/completions"

# Google Gemini — οπτική αναγνώριση (OCR) για σαρωμένες προτάσεις έργων.
# Χωρίς GEMINI_API_KEY τα σαρωμένα PDF απορρίπτονται με ρητό μήνυμα· τα
# ψηφιακά αρχεία δεν το χρειάζονται καθόλου.
# ΠΡΟΣΟΧΗ: εδώ φεύγουν ΕΙΚΟΝΕΣ σελίδων — δεν μασκάρονται. Ό,τι είναι τυπωμένο
# πάνω τους (ΑΦΜ, IBAN, ονόματα, τιμές) το βλέπει η Google. Η μάσκα μπαίνει
# μετά, στο κείμενο που γυρίζει.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite"

# ──────────────────────────────────────────────────────────────────────────
# External Services (Optional)
# ──────────────────────────────────────────────────────────────────────────
CLAID_API_KEY="your-claid-api-key"
GEOCODE_API="your-geocoding-api-key"
MAPTILER_API_KEY="your-maptiler-api-key"

# ──────────────────────────────────────────────────────────────────────────
# SoftOne ERP Integration (Optional)
# ──────────────────────────────────────────────────────────────────────────
SOFTONE_USERNAME="your-softone-username"
SOFTONE_PASSWORD="your-softone-password"
SOFTONE_URL="https://your-domain.oncloud.gr"
SOFTONE_APP_ID="2000"
SOFTWARE_SERIAL="YOUR-SERIAL-CODE"
SOFTWARE_COMPANY_VENTOR="Your Company Name"
SOFTWARE_COMPANY_BUYER="Buyer Company Name"

# ──────────────────────────────────────────────────────────────────────────
# Project Tasks MCP (Optional)
# Existing human PMS user shown as actor for assignments and resolution reviews.
# Recommended: the Microsoft account email used to sign in to the PMS.
# ──────────────────────────────────────────────────────────────────────────
MCP_OPERATOR_USER_EMAIL="email@company.gr"
# Alternative legacy lookup; used only when MCP_OPERATOR_USER_EMAIL is empty.
MCP_OPERATOR_USER_ID=""
# Optional comma-separated extra HTTPS hosts allowed for attachment downloads.
MCP_ATTACHMENT_ALLOWED_HOSTS=""

# ──────────────────────────────────────────────────────────────────────────
# Node Configuration
# ──────────────────────────────────────────────────────────────────────────
NIXPACKS_NODE_VERSION=22
NODE_ENV=development

# ==============================================================================
# IMPORTANT SECURITY NOTES:
# ==============================================================================
# 1. NEVER commit .env.local to version control
# 2. Keep all secrets secure and rotate regularly
# 3. Use strong, unique values for all SECRET keys
# 4. Different values for development, staging, and production
# 5. Use your hosting provider's secrets management in production
# 6. Regularly audit and update API keys
#
# REQUIRED SERVICES:
# - MySQL 8.0+ database
# - BunnyCDN account for file storage (MANDATORY)
# - Mailgun account for email delivery
# - Microsoft 365 tenant for authentication (MANDATORY)
# - Auth.js configured and running
#
# OPTIONAL SERVICES:
# - OpenAI for AI features
# - DeepSeek for alternative LLM
# - SoftOne ERP integration
# - GeoCoding and MapTiler for location services
#
# ==============================================================================

